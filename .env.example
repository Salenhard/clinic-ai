# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional — used by docker-compose.yml ──────────────────────────────────────
INPUT_FILE=guidelines.pdf          # filename inside ./data/input/
OUTPUT_FILE=graph.json             # filename inside ./data/output/
METRICS_FILE=metrics.json          # filename inside ./data/output/

MODEL=claude-sonnet-4-20250514     # Claude model to use

# Requests per minute — match your API tier:
#   Free tier:  5
#   Tier 1:    50
#   Tier 2+:  500
RPM=5

# Leave blank to process the whole document
SECTION=

# Set to any non-empty value to enable flags
VERBOSE=
USE_CACHE=
