# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Required ─────────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ── Model & rate limit ────────────────────────────────────────────────────────
# gemini-2.0-flash       → 15 RPM free tier  (default, recommended)
# gemini-2.0-flash-lite  → 30 RPM free tier  (faster, lower quota cost)
# gemini-1.5-pro         →  2 RPM free tier  (most capable)
MODEL=gemini-2.0-flash
RPM=15

# ── Chunking ─────────────────────────────────────────────────────────────────
# CHUNK_SIZE: max characters per chunk sent to LLM
#   12000 chars ≈ 3000 tokens — safe for all Gemini models
#   Smaller = more chunks = more API calls but less context per call
#   Larger  = fewer chunks = fewer API calls but risks truncation
CHUNK_SIZE=12000

# OVERLAP: chars from end of chunk N prepended to chunk N+1
#   Prevents losing context at chunk boundaries
#   400–600 is usually enough for clinical text
OVERLAP=400

# ── File names ────────────────────────────────────────────────────────────────
INPUT_FILE=guidelines.pdf
OUTPUT_FILE=graph.json
METRICS_FILE=metrics.json

# ── Optional flags ────────────────────────────────────────────────────────────
SECTION=          # focus on specific section, e.g. "переломы шейки бедра"
VERBOSE=          # any non-empty value enables --verbose
USE_CACHE=        # any non-empty value enables --use-cache
