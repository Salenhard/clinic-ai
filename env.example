# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ── Optional ────────────────────────────────────────────────────────────────────
INPUT_FILE=guidelines.pdf
OUTPUT_FILE=graph.json
METRICS_FILE=metrics.json

# Gemini model options:
#   gemini-2.0-flash       — fast, free tier friendly (default)
#   gemini-2.0-flash-lite  — fastest, lowest quota usage
#   gemini-1.5-pro         — most capable, higher quota cost
MODEL=gemini-2.0-flash

# Requests per minute — free tier limits:
#   gemini-2.0-flash:      15 RPM
#   gemini-2.0-flash-lite: 30 RPM
#   gemini-1.5-pro:        2 RPM
RPM=15

# Leave blank to process the whole document
SECTION=

# Set to any non-empty value to enable the flag
VERBOSE=
USE_CACHE=
